{
  "name": "snake-smart",
  "version": "1.0.0",
  "description": "SNAKE Smart Cross-Platform Game",
  "main": "electron-main.js",
  "scripts": {
    "start": "electron .",
    "build:win": "electron-builder --win",
    "build:linux": "electron-builder --linux"
  },
  "build": {
    "appId": "com.snakesmart.game",
    "productName": "SNAKE Smart",
    "files": [
      "www/**/*",
      "electron-main.js",
      "package.json"
    ],
    "win": {
      "target": "portable"
    },
    "linux": {
      "target": "AppImage"
    }
  },
  "devDependencies": {
    "@capacitor/android": "^6.0.0",
    "@capacitor/cli": "^6.0.0",
    "@capacitor/core": "^6.0.0",
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3"
  }
}

